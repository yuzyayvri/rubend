import Base
import ./model.bend as Model

type Cubie is Data:
  Cubie{cp: U32, co: U32, ep: U32, eh: U32, eo: U32}

type Validation is Data:
  Valid{cube: Cubie}
  Invalid{code: U32}

def pick(side: Bool, a: U32, b: U32) -> U32:
  match side:
    case True{}:
      a
    case False{}:
      b

def nib(+word: U32, index: U32) -> U32:
  ((word >> U32.to_nat((index * 4 : U32))) .&. 15 : U32)

def bit(+word: U32, index: U32) -> U32:
  ((word >> U32.to_nat(index)) .&. 1 : U32)

def solved() -> Cubie:
  Cubie{1985229328, 0, 1985229328, 47768, 0}

