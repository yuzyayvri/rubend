def corner_color(piece: U32, side: U32) -> U32:
  match piece side:
    case 0 0:
      0
    case 0 1:
      1
    case 0 2:
      2
    case 1 0:
      0
    case 1 1:
      2
    case 1 2:
      4
    case 2 0:
