def find_corner(a: U32, b: U32, c: U32) -> U32:
  match a b c:
    case 0 1 2:
      0
    case 2 0 1:
      16
    case 1 2 0:
      32
    case 0 2 4:
      1
    case 4 0 2:
      17
    case 2 4 0:
      33
    case 0 4 5:
      2
    case 5 0 4:
      18
    case 4 5 0:
      34
    case 0 5 1:
      3
    case 1 0 5:
      19
    case 5 1 0:
      35
    case 3 2 1:
      4
    case 1 3 2:
      20
    case 2 1 3:
      36
    case 3 4 2:
      5
    case 2 3 4:
      21
    case 4 2 3:
      37
    case 3 5 4:
      6
    case 4 3 5:
      22
    case 5 4 3:
      38
    case 3 1 5:
      7
    case 5 3 1:
      23
    case 1 5 3:
      39
    case _ _ _:
      255

def find_edge(a: U32, b: U32) -> U32:
  match a b:
    case 0 1:
      0
    case 1 0:
      16
    case 0 2:
      1
    case 2 0:
      17
    case 0 4:
      2
    case 4 0:
      18
    case 0 5:
      3
    case 5 0:
      19
    case 3 1:
      4
    case 1 3:
      20
    case 3 2:
      5
    case 2 3:
      21
    case 3 4:
      6
    case 4 3:
      22
    case 3 5:
      7
    case 5 3:
      23
    case 2 1:
      8
    case 1 2:
      24
    case 2 4:
      9
    case 4 2:
      25
    case 5 4:
      10
    case 4 5:
      26
    case 5 1:
      11
    case 1 5:
      27
    case _ _:
      255

def parity_pairs(fuel: Nat, +lo: U32, +hi: U32, +i: U32, +j: U32, acc: U32) -> U32:
  match fuel:
    case 0n:
      acc
    case 1n+p:
      parity_pairs(p, lo, hi, i, (j + 1 : U32), (acc .^. pick(U32.is_gt(nib(pick(U32.is_lt(i, 8), lo, hi), (i % 8 : U32)), nib(pick(U32.is_lt(j, 8), lo, hi), (j % 8 : U32))), 1, 0) : U32))

def parity(fuel: Nat, +lo: U32, +hi: U32, +n: U32, +i: U32, acc: U32) -> U32:
  match fuel:
    case 0n:
      acc
    case 1n+p:
      parity(p, lo, hi, n, (i + 1 : U32), parity_pairs(U32.to_nat((n - i - 1 : U32)), lo, hi, i, (i + 1 : U32), acc))

def validate_parity(ok: Bool, cube: Cubie) -> Validation:
  match ok:
    case True{}:
      Valid{cube}
    case False{}:
      Invalid{5}

def validate_orientation(twist: U32, flip: U32, cube: Cubie) -> Validation:
  match twist flip cube:
    case 0 0 Cubie{+cp, co, +ep, +eh, eo}:
      validate_parity(U32.is_eq(parity(8n, cp, 0, 8, 0, 0), parity(12n, ep, eh, 12, 0, 0)), Cubie{cp, co, ep, eh, eo})
    case 0 _ _:
      Invalid{4}
    case _ _ _:
      Invalid{3}

def validate_pieces(ok: Bool, twist: U32, flip: U32, cube: Cubie) -> Validation:
  match ok:
    case True{}:
      validate_orientation(twist, flip, cube)
    case False{}:
      Invalid{2}

def validate_codes(centers: Bool, +c0: U32, +c1: U32, +c2: U32, +c3: U32, +c4: U32, +c5: U32, +c6: U32, +c7: U32, +e0: U32, +e1: U32, +e2: U32, +e3: U32, +e4: U32, +e5: U32, +e6: U32, +e7: U32, +e8: U32, +e9: U32, +e10: U32, +e11: U32) -> Validation:
  match centers:
    case False{}:
