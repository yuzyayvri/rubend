def Laws.sym48_composition_action(left, right, cube):
  %paint_permute(right, left, S.permute(right, cube)) : {S.apply(S.compose(left, right), cube) == S.paint(left, _) : M.Cube}
  %paint_composition(left, right, S.permute(left, S.permute(right, cube))) : {S.apply(S.compose(left, right), cube) == _ : M.Cube}
  %permute_composition(left, right, cube) : {S.apply(S.compose(left, right), cube) == S.paint(S.compose(left, right), _) : M.Cube}
  {==}

def Laws.sym48_inverse_action(sym, cube):
