import Base
import ./model.bend as M

type Face is Data:
  FaceU{}
  FaceR{}
  FaceF{}
  FaceD{}
  FaceL{}
  FaceB{}

type Power is Data:
  One{}
  Two{}
  Three{}

def move(face: Face, power: Power) -> M.Move:
  match face power:
    case FaceU{} One{}:
      M.U{}
    case FaceU{} Two{}:
      M.U2{}
    case FaceU{} Three{}:
      M.Ui{}
    case FaceR{} One{}:
      M.R{}
    case FaceR{} Two{}:
      M.R2{}
    case FaceR{} Three{}:
      M.Ri{}
    case FaceF{} One{}:
      M.F{}
    case FaceF{} Two{}:
      M.F2{}
    case FaceF{} Three{}:
      M.Fi{}
    case FaceD{} One{}:
      M.D{}
    case FaceD{} Two{}:
      M.D2{}
    case FaceD{} Three{}:
      M.Di{}
    case FaceL{} One{}:
      M.L{}
    case FaceL{} Two{}:
      M.L2{}
    case FaceL{} Three{}:
      M.Li{}
    case FaceB{} One{}:
      M.B{}
    case FaceB{} Two{}:
      M.B2{}
    case FaceB{} Three{}:
      M.Bi{}

def opposite(face: Face) -> Face:
  match face:
    case FaceU{}:
      FaceD{}
    case FaceR{}:
      FaceL{}
    case FaceF{}:
      FaceB{}
    case FaceD{}:
      FaceU{}
    case FaceL{}:
      FaceR{}
    case FaceB{}:
      FaceF{}

def combined(face: Face, p: Power, q: Power, cube: M.Cube) -> M.Cube:
  match p q:
    case One{} One{}:
      M.turn(move(face, Two{}), cube)
    case One{} Two{}:
      M.turn(move(face, Three{}), cube)
    case One{} Three{}:
      cube
    case Two{} One{}:
      M.turn(move(face, Three{}), cube)
    case Two{} Two{}:
      cube
    case Two{} Three{}:
      M.turn(move(face, One{}), cube)
    case Three{} One{}:
      cube
    case Three{} Two{}:
      M.turn(move(face, One{}), cube)
    case Three{} Three{}:
      M.turn(move(face, Two{}), cube)

law same_face_reduces:
  for +face: Face
  for +p: Power
  for +q: Power
  for +cube: M.Cube
  {M.turn(move(face, q), M.turn(move(face, p), cube)) == combined(face, p, q, cube) : M.Cube}

def same_face_reduces(face, p, q, cube):
  match face p q cube:
    case FaceU{} One{} One{} M.Cube{s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38, s39, s40, s41, s42, s43, s44, s45, s46, s47, s48, s49, s50, s51, s52, s53}:
