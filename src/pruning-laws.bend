law opposite_commutes:
  for +face: Face
  for +p: Power
  for +q: Power
  for +cube: M.Cube
  {M.turn(move(opposite(face), q), M.turn(move(face, p), cube)) == M.turn(move(face, p), M.turn(move(opposite(face), q), cube)) : M.Cube}

def opposite_commutes(face, p, q, cube):
