def compose_word(+root: P.PieceCells, +word: +List<M.Move>, +cells: P.PieceCells) -> {compose(root, P.replay(word, cells)) == P.replay(word, compose(root, cells)) : P.PieceCells}:
  match word:
    case Nil{}: {==}
    case Con{+move, +rest}:
      Equal.trans(P.PieceCells, compose(root, P.replay(rest, P.turn(move, cells))), P.replay(rest, compose(root, P.turn(move, cells))), P.replay(rest, P.turn(move, compose(root, cells))), compose_word(root, rest, P.turn(move, cells)), Equal.cong(P.PieceCells, P.PieceCells, state => P.replay(rest, state), compose(root, P.turn(move, cells)), P.turn(move, compose(root, cells)), compose_turn(root, move, cells)))
