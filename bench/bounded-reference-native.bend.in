import Base
import {{MODEL}} as M
import {{REFERENCE}} as R

type BRTNativeCase is Data:
  BRTCase{values: +List<U32>, radius: U32}

def mix(values: +List<U32>, sum: U32) -> U32:
  match values:
    case Nil{}: sum
    case Con{value, rest}: mix(rest, ((sum * 16777619 : U32) .^. value : U32))

def parsed(radius: U32, sum: U32, cube: Maybe<&2, M.Cube>) -> U32:
  match cube:
    case None{}: 0
    case Some{cube}: mix(R.test_search(radius, cube), sum)

def run(cases: List<BRTNativeCase>, sum: U32) -> U32:
  match cases:
    case Nil{}: sum
    case Con{BRTCase{values, radius}, rest}: run(rest, parsed(radius, sum, M.from_list(values)))

def main() -> IO(Unit):
  IO.print(U32.show(run({{CASES}}, 17)))
