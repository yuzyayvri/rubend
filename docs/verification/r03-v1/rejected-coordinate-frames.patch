@@ -0,0 +1,25 @@
+import Base
+import ./fixed-work.bend as F
+import ../src/search.bend as S
+
+def profile(raw: Bool) -> S.Profile:
+  match raw:
+    case True{}: S.RawCoordinates{}
+    case False{}: S.LightCoordinates{}
+
+def start(args: List<String>) -> IO(Unit):
+  match args:
+    case Con{program, Con{+tier, Con{path, Nil{}}}}:
+      do IO<Unit>:
+        table : Array<U32> <- F.load(String.eq(tier, "raw"))
+        file : File <- IO.try(File, File.open(path, "r"))
+        read : File & Result<&1, &1, U32 & String, String> <- File.read(file, 4096)
+        text : String <- F.read_requests(16n, "", read)
+        table : Array<U32> <- F.commands(String.split(text, Chr{10}), table, profile(String.eq(tier, "raw")))
+        IO.pure(Unit, Unit{})
+    case _: IO.die(Unit, 2, "Expected light|raw and request file")
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    args : List<String> <- IO.args()
+    start(args)
