diff --git a/bench/frame-refinement.mjs b/bench/frame-refinement.mjs
new file mode 100644
index 0000000..83dd40b
--- /dev/null
+++ b/bench/frame-refinement.mjs
@@ -0,0 +1,42 @@
+import assert from "node:assert/strict";
+import {readFileSync} from "node:fs";
+import {resolve} from "node:path";
+import {fileURLToPath} from "node:url";
+import {createHash} from "node:crypto";
+import Cubie from "../build/cubie.mjs";
+import Coordinates from "../build/coordinates.mjs";
+import {encode,validate} from "../apps/model.mjs";
+import {apply} from "./fixed-work-model.mjs";
+
+const words=c=>[c.cp,c.co,c.ep,c.eh,c.eo];
+const unpack=v=>{assert.ok(Array.isArray(v)&&v.length===5);assert.ok(v.every(n=>Number.isSafeInteger(n)&&n>=0&&n<=4294967295));const [cp,co,ep,eh,eo]=v;return {$:"Cubie",cp,co,ep,eh,eo};};
+export function refineFrame(frame,root){
+  assert.ok(Array.isArray(frame)&&frame.length===4);assert.ok([0,1].includes(frame[0]));
+  const [,actual,fields,path]=frame;assert.ok(Array.isArray(path));assert.ok(Array.isArray(fields));
+  const retry=frame[0]===1;assert.equal(fields.length,retry?6:8);
+  const phase=retry?1:fields[6];assert.ok([0,1,2].includes(phase));
+  assert.equal(path.length,fields[retry?5:7],"Frame path length differs");
+  const expected=validate(apply(encode(Cubie.to_facelets(unpack(root))),[...path].reverse()));
+  assert.deepEqual(actual,words(expected),"Frame abstract cube differs from independent path replay");
+  const kinds=phase===1?["Corners","Edges","Middle"]:["Twist","Flip","Slice"];
+  if(phase===1){assert.equal(expected.co,0,"Subgroup corner orientation");assert.equal(expected.eo,0,"Subgroup edge orientation");assert.equal(Coordinates.encode({$:"Slice"},expected),0,"Subgroup slice membership");}
+  assert.deepEqual(fields.slice(0,3),kinds.map(k=>Coordinates.encode({$:k},expected)),"Frame coordinates differ from independent path replay");
+  return {phase,retry};
+}
+export function checkFrameRefinement(snapshots){
+  const result={snapshots:0,frames:0,subgroupNodes:0,retries:0,otherNodes:0};
+  for(const snapshot of snapshots){
+    assert.equal(snapshot.type,"snapshot");assert.equal(snapshot.state.length,3);result.snapshots++;
+    for(const [axis,meta,frames] of snapshot.state[2]){
+      assert.ok(Number.isInteger(axis)&&axis>=0&&axis<=5);
+      for(const frame of frames){const r=refineFrame(frame,meta[0]);result.frames++;if(r.retry)result.retries++;else if(r.phase===1)result.subgroupNodes++;else result.otherNodes++;}
+    }
+  }
+  assert.ok(result.subgroupNodes>0,"No subgroup frame was checked");
+  return result;
+}
+if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url)){
+  assert.equal(process.argv.length,3,"Expected fixed-work report");const bytes=readFileSync(process.argv[2]),report=JSON.parse(bytes);
+  assert.equal(report.passed,true);assert.equal(report.format,"rubend-fixed-work-v1");
+  console.log(JSON.stringify({passed:true,inputSha256:createHash("sha256").update(bytes).digest("hex"),...checkFrameRefinement(report.snapshots),scope:"Independent facelet replay plus generated Bend coordinate ranking. Abstraction reconstruction is outside timed search."}));
+}
